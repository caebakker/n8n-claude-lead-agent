# Copy to .env and replace the encryption key before you store real credentials.
# The defaults run the demo with a mocked Claude response and a CRM stub.

N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
GENERIC_TIMEZONE=Europe/London

# mock skips Anthropic and returns the sample qualifications.
# live calls the Messages API with the credential on the Claude nodes.
CLAUDE_MODE=mock
CLAUDE_MODEL=claude-sonnet-5-5

# stub writes a local id. hubspot uses the HubSpot node.
CRM_MODE=stub

# Used only if you point the Claude HTTP header at this variable yourself.
# The shipped workflow reads the key from an n8n Header Auth credential, not from this line.
ANTHROPIC_API_KEY=

WEBHOOK_URL=http://localhost:5678/webhook/lead-agent
